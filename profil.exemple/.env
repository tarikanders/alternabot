# Copie ce fichier dans profil/.env et remplis les valeurs. Ne le partage jamais.

# Optionnelle : seulement si ia.moteur vaut "api" dans config.yaml
ANTHROPIC_API_KEY=

# Jeton de l'API La Bonne Alternance (voir docs/LBA.md)
LBA_API_TOKEN=

# Clé Google Maps Platform avec l'API Places activée (voir docs/GOOGLE-MAPS.md)
GOOGLE_MAPS_API_KEY=

# Optionnelle : offres publiées sur Google (SerpAPI)
SERPAPI_KEY=

# Mot de passe d'application du premier compte Gmail (voir docs/GMAIL.md)
# Pour un 2e compte, ajoute GMAIL_MDP_2 et déclare-le dans config.yaml
GMAIL_MDP_1=
